# Local litellm proxy (Anthropic-compatible endpoint -> Google models)
ANTHROPIC_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=your-litellm-master-key
ANTHROPIC_API_KEY=DUMMY_KEY
ANTHROPIC_AUTH_TOKEN=DUMMY_KEY
ANTHROPIC_MODEL=gemini-3-flash

# Google AI (used by the litellm proxy in dev; users supply their own key in-app for prod)
GOOGLE_API_KEY=your-google-api-key

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Postgres connection string (Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_ID=""
GITHUB_SECRET=""

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=""

# 32-byte base64 secret used to encrypt user-supplied AI provider credentials
# (AiCredential — every provider, not just Google). The variable name is kept
# deliberately: renaming it, or changing the v1:<iv>:<tag>:<ciphertext> payload
# format, makes every already-stored credential permanently undecryptable.
# Golden-vector test guarding the format: tests/security/api-key.test.ts.
# Generate with: openssl rand -base64 32
GOOGLE_KEY_ENCRYPTION_SECRET=""

# Credentials sign-up. OFF unless exactly "true" — there is no password reset
# (no mail provider), so a forgotten password means a lost account. Signing IN
# with a password is always available and is NOT gated by this.
CREDENTIALS_SIGNUP_ENABLED=""

# Local development account for `npm run seed:dev-user`. Never set these in
# production — the script refuses to run there.
DEV_USER_EMAIL="dev@localhost.test"
DEV_USER_HANDLE="dev_user"
DEV_USER_PASSWORD=""
