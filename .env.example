# Local litellm proxy (Anthropic-compatible endpoint -> Google models)
ANTHROPIC_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=your-litellm-master-key
ANTHROPIC_API_KEY=DUMMY_KEY
ANTHROPIC_AUTH_TOKEN=DUMMY_KEY
ANTHROPIC_MODEL=gemini-3-flash

# Google AI (used by the litellm proxy in dev; users supply their own key in-app for prod)
GOOGLE_API_KEY=your-google-api-key

# `npm run author-klps --direct` only (an operator tool; the app itself uses the
# encrypted per-user AiCredential pool, managed at /settings/ai).
#
# The Gemini free tier caps GenerateRequests PER DAY, PER MODEL, PER PROJECT —
# measured at 20, against roughly 6 calls per authored card. The script therefore
# rotates over the CROSS PRODUCT of keys and models, retiring a pair when the
# provider names a per-day quota for it and moving to the next.
#
# Comma or whitespace separated. Both plural forms are optional: the singular
# GOOGLE_API_KEY / KLP_DIRECT_MODEL above still work and are merged in.
# GOOGLE_API_KEYS=key-one,key-two
# KLP_DIRECT_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash

# Email (Resend). ABSENT -> the console transport: verification and reset links
# print to the server log, which is how this feature is driven end to end
# locally with no inbox involved. Set it (plus a verified sending domain) and
# real messages go out. See src/lib/mail/.
RESEND_API_KEY=""
MAIL_FROM="Quizlet <noreply@yourdomain.example>"
# Where /help submissions are emailed. Falls back to the maintainer's address
# when unset. The submission is stored in the Feedback table either way, so a
# missing RESEND_API_KEY loses the mail but never the message.
FEEDBACK_TO=""

# Postgres connection string (Neon or Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_ID=""
GITHUB_SECRET=""

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=""

# 32-byte base64 secret used to encrypt user-supplied AI provider credentials
# (AiCredential — every provider, not just Google). The variable name is kept
# deliberately: renaming it, or changing the v1:<iv>:<tag>:<ciphertext> payload
# format, makes every already-stored credential permanently undecryptable.
# Golden-vector test guarding the format: tests/security/api-key.test.ts.
# Generate with: openssl rand -base64 32
GOOGLE_KEY_ENCRYPTION_SECRET=""

# Credentials sign-up. OFF unless exactly "true" — a master kill switch, not
# the growth control (invite codes are the cap). Password reset exists
# (/forgot, /reset/[token]); this flag does not gate signing in, resetting a
# password, or verifying an address.
CREDENTIALS_SIGNUP_ENABLED=""

# Local development account for `npm run seed:dev-user`. Never set these in
# production — the script refuses to run there.
DEV_USER_EMAIL="dev@localhost.test"
DEV_USER_HANDLE="dev_user"
DEV_USER_PASSWORD=""

# ---------------------------------------------------------------------------
# Background KLP authoring (vercel.json -> /api/cron/author-klps)
# ---------------------------------------------------------------------------
# The Google free tier is 20 requests per day PER MODEL per project and does
# NOT accumulate: quota unused today is gone. One card costs 6-16 calls, so a
# schedule is the only thing that actually spends it. Runs every 3 hours,
# authoring at most a few cards each time, and always serving byte-identical
# cards from an existing twin first at zero cost.
#
# Vercel sends `Authorization: Bearer $CRON_SECRET` on scheduled invocations.
# With this UNSET the route refuses every request, including real cron ones —
# it spends the operator's AI quota, so an open version of it is a way for
# anyone who guesses the path to burn a day's budget. Generate any long random
# string and set the same value in the Vercel project settings.
CRON_SECRET=""

# Whose stored AiCredential pool pays for background authoring. Background work
# belongs to no requesting user, so one has to be named. An explicit id rather
# than "the first admin" — who pays should not move when a role is granted.
CRON_AUTHOR_USER_ID=""

# `npm run author-klps -- --direct` provider selection. Defaults to google.
# Set to `deepseek` to run the same pipeline on DEEPSEEK_API_KEY instead, which
# is how a provider's authoring quality gets measured on exactly the path the
# other one runs on. See docs/ai/model-performance.md.
KLP_DIRECT_PROVIDER=""
DEEPSEEK_API_KEY=""
