    {
      "id": "cmsfkfuzv000704jowvit6udw",
      "term": "Walk me through the income statement",
      "setTitle": "Accounting - \"Talking\"",
      "klps": [
        {
          "text": "Gross Profit is calculated as Revenue minus Cost of Goods Sold, representing the direct profitability of the company's core production.",
          "kind": "mechanism"
        },
        {
          "text": "Operating expenses encompass SG&A for overhead and D&A for the allocation of long-term asset costs.",
          "kind": "definition"
        },
        {
          "text": "EBIT represents the operating profit remaining after all production and overhead costs are accounted for.",
          "kind": "definition"
        },
        {
          "text": "EBITDA is derived by adding D&A back to EBIT to normalize for non-cash accounting charges related to capital investments.",
          "kind": "causal"
        },
        {
          "text": "Net Income is the final bottom-line figure calculated after deducting interest expenses and taxes from the operating results.",
          "kind": "mechanism"
        }
      ],
