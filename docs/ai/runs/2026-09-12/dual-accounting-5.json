    {
      "id": "cmsfkfuzb000404josox97czt",
      "term": "How do the three statements link together?",
      "setTitle": "Accounting - \"Talking\"",
      "klps": [
        {
          "text": "Net income from the income statement flows into retained earnings to update shareholders' equity on the balance sheet.",
          "kind": "causal"
        },
        {
          "text": "Net income serves as the starting point for the cash flow from operations section on the cash flow statement.",
          "kind": "mechanism"
        },
        {
          "text": "Changes in operating working capital accounts on the balance sheet are used to adjust net income to cash from operations on the cash flow statement.",
          "kind": "mechanism"
        },
        {
          "text": "Investing activities on the cash flow statement reflect the purchase and sale of long-term assets that appear on the balance sheet, such as property, plant, and equipment.",
          "kind": "causal"
        },
        {
          "text": "Financing activities on the cash flow statement capture transactions involving debt and equity that alter the right-hand side of the balance sheet.",
          "kind": "causal"
        },
        {
          "text": "The net change in cash from the cash flow statement is added to the beginning cash balance to yield the ending cash balance on the balance sheet.",
          "kind": "quantitative"
        }
      ],
