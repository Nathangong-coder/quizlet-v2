    {
      "id": "cmsfkfvgr003p04jocjuzwwgo",
      "term": "** (WEIRD) What is the difference between IRR and WACC?",
      "setTitle": "Accounting - \"Talking\"",
      "klps": [
        {
          "text": "IRR is the projected return on a project's expenditures — the implied interest rate needed on the initial investment to match the project's projected returns.",
          "kind": "definition"
        },
        {
          "text": "WACC is the minimum required return that the company's debt and equity providers demand, blended and weighted by the capital mix.",
          "kind": "definition"
        },
        {
          "text": "IRR is computed solely from a specific project's own cash flows, independent of how the firm is financed.",
          "kind": "contrast"
        },
        {
          "text": "WACC is computed from the company's capital structure — the proportions and costs of its debt and equity — and is the same for every project the firm considers.",
          "kind": "contrast"
        },
        {
          "text": "WACC acts as the hurdle rate — a project creates value only if its IRR exceeds the WACC.",
          "kind": "condition"
        }
      ],
      "conflictsSent": [
        {
          "klpRef": 3,
          "kind": "name_conflict",
          "klpKind": "contrast",
          "aName": "firm-wide uniformity of WACC",
          "bName": "weighted average cost of capital",
          "conflictIndex": 0
        },
        {
          "klpRef": 0,
          "kind": "extra_context",
